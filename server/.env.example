# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_and_found

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Upload Settings
MAX_FILE_SIZE_MB=5

# Optional Demo Seeding Variables
# Set these when running `npm run seed` to initialize demo accounts
SEED_ADMIN_EMAIL=admin@campus.edu
SEED_ADMIN_PASSWORD=AdminPass2026!
SEED_ADMIN_NAME="Campus Administrator"
