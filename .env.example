# ===============================================
# Campus Lost & Found - Environment Configuration Template
# Copy this file to `server/.env` before running the backend
# ===============================================

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for CORS allowed origins)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_and_found

# Authentication Secret & Expiration
JWT_SECRET=replace_with_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Upload Constraints
MAX_FILE_SIZE_MB=5

# Demo Administrator Seed Credentials (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@campus.edu
SEED_ADMIN_PASSWORD=AdminPass2026!
SEED_ADMIN_NAME="Campus Administrator"
